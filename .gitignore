# ==============================================================================
# Comprehensive Security & Confidential File Exclusions (.gitignore)
# School Management System (SMS) - Ghana Education Service (GES) Standard
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Confidential Credentials (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local
*.env
*.env.*

# API Keys, Private Keys, Certificates & Tokens
*.pem
*.key
*.crt
*.p12
*.pfx
*.asc
*.jwt
*.keystore
service-account*.json
google-services.json
credentials.json
secrets.json

# ------------------------------------------------------------------------------
# 1b. Provisioning & Admin Setup Scripts (contain fallback credentials)
# ------------------------------------------------------------------------------
/scripts/

# ------------------------------------------------------------------------------
# 2. Database Dumps & Local Data Backups
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
*.pgdump
/supabase/.temp/
/supabase/.branches/

# ------------------------------------------------------------------------------
# 3. System & Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# 4. Dependency Directories & Package Managers
# ------------------------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
/.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# 5. Build Outputs & Next.js Compilation Artifacts
# ------------------------------------------------------------------------------
/.next/
/out/
/build
/dist
/coverage
*.tsbuildinfo
next-env.d.ts
.vercel

# ------------------------------------------------------------------------------
# 6. Log Files & Audit Traces
# ------------------------------------------------------------------------------
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/logs/

# ------------------------------------------------------------------------------
# 7. IDE & Code Editor Workspace Settings
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.user
